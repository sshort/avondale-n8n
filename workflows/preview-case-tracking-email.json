    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = $('Load Global Settings').first()?.json ?? {};\nconst request = $('Preview Case Tracking Email Webhook').first()?.json ?? $input.first()?.json ?? {};\nconst query = request.query ?? request;\nconst headers = request.headers ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst truthy = (value) => ['1', 'true', 'yes', 'y', 'on'].includes(clean(value).toLowerCase());\nconst deriveBaseUrl = (headers, fallback) => {\n  const forwardedProto = clean(headers['x-forwarded-proto']);\n  const forwardedHost = clean(headers['x-forwarded-host']);\n  const host = forwardedHost || clean(headers.host);\n  const forwardedPort = clean(headers['x-forwarded-port']);\n  if (!host) return fallback;\n  const proto = forwardedProto || 'http';\n  let authority = host;\n  if (forwardedPort && !authority.includes(':')) {\n    const isDefaultPort = (proto === 'http' && forwardedPort === '80') || (proto === 'https' && forwardedPort === '443');\n    if (!isDefaultPort) authority = authority + ':' + forwardedPort;\n  }\n  return proto + '://' + authority;\n};\nconst fallbackBaseUrl = clean(settings.n8n_base_url) || 'http://n8n:5678';\nconst n8nBaseUrl = deriveBaseUrl(headers, fallbackBaseUrl);\nconst caseId = /^[0-9a-fA-F-]{36}$/.test(clean(query.case_id)) ? clean(query.case_id) : '';\nconst templateKey = clean(query.template_key);\nconst signatureTemplateKey = clean(query.signature_template_key) || clean(settings.email_signature_template_key) || 'signature';\nconst returnUrl = clean(query.return_url) || (n8nBaseUrl + '/webhook/case-tracking?view=dashboard');\nconst deliveryMode = truthy(query.test_mode) || clean(settings.email_delivery_mode) !== 'production' ? 'test' : 'production';\nconst errorMessage = !caseId ? 'case_id is required.' : '';\nreturn [{ json: { case_id: caseId, template_key: templateKey, signature_template_key: signatureTemplateKey, to: clean(query.to), return_url: returnUrl, n8n_base_url: n8nBaseUrl, send_url: n8nBaseUrl + '/webhook/send-case-tracking-email', delivery_mode: deliveryMode, test_recipient: clean(settings.email_test_recipient) || 'steve.short@gmail.com', sender_name: clean(settings.email_sender_name) || 'Steve Short', reply_to: clean(settings.email_reply_to) || 'members.avondaleltc@gmail.com', error_message: errorMessage } }];"
      },
