    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $('Render Preview Data').first()?.json ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\nconst toScriptString = (value) => JSON.stringify(String(value ?? '')).replace(/<\\/script/gi, '<\\\\/script');\nconst toScriptJson = (value) => JSON.stringify(value ?? null).replace(/<\\/script/gi, '<\\\\/script');\nconst modeChecked = item.delivery_mode === 'production' ? '' : ' checked';\nconst modeLabel = item.delivery_mode === 'production' ? 'Production' : 'Test';\nconst recipientSummary = item.delivery_mode === 'production'\n  ? escapeHtml(item.actual_recipient)\n  : escapeHtml(item.actual_recipient) + ' (intended recipient: ' + escapeHtml(item.intended_recipient) + ')';\nconst warningHtml = item.missing_recipient ? '<div class=\"alert alert-warning shadow-sm\"><span>' + escapeHtml(item.missing_recipient) + '</span></div>' : '';\nconst initialBodyLiteral = toScriptString(item.rendered_message || '');\nconst initialSignatureLiteral = toScriptString(item.rendered_signature || '');\nconst availableImagesLiteral = toScriptJson(Array.isArray(item.image_rows) ? item.image_rows : []);\nconst imageAssetUrlBaseLiteral = toScriptString(item.image_asset_url_base || '');\nconst imageActionsUrlLiteral = toScriptString(item.image_actions_url || '');\nconst html = [\n  '<!doctype html>',\n  '<html lang=\"en\">',\n  '<head>',\n  '  <meta charset=\"utf-8\">',\n  '  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">',\n  '  <title>Email Preview</title>',\n  '  <link href=\"https://cdn.jsdelivr.net/npm/daisyui@5\" rel=\"stylesheet\" type=\"text/css\" />',\n  '  <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>',\n  '  <style>',\n  '    body { background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%); }',\n  '    .editor-frame { width: min(92%, 54rem); max-width: 100%; min-width: min(100%, 34rem); align-self: flex-start; border: 1px solid oklch(var(--b3)); border-radius: 1rem; background: white; overflow: hidden; }',\n  '    .editor-textarea-hidden { display: none; }',\n  '    .editor-inline-host { min-height: 22rem; padding: 1rem; }',\n  '    .editor-inline-host[contenteditable=\"true\"]:focus { outline: none; }',\n  '    .preview-surface { min-height: 12rem; border-radius: 1rem; background: linear-gradient(180deg, #fff 0%, #f8fafc 100%); border: 1px solid color-mix(in oklab, oklch(var(--b3)) 75%, white); padding: 1.25rem; }',\n  '    .preview-surface table { width: 100%; border-collapse: collapse; }',\n  '    .preview-surface td, .preview-surface th { border: 1px solid #dbe1ea; padding: .5rem; }',\n  '    .preview-text { white-space: pre-wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .9rem; line-height: 1.5; border-radius: 1rem; background: #f8fafc; border: 1px solid color-mix(in oklab, oklch(var(--b3)) 75%, white); padding: 1rem; }',\n  '    .tox-tinymce-inline { border: 0 !important; }',\n  '    .tox-editor-header { box-shadow: none !important; border-bottom: 1px solid color-mix(in oklab, oklch(var(--b3)) 75%, white) !important; }',\n  '    .tox-toolbar__primary { flex-wrap: wrap !important; }',\n  '  </style>',\n  '</head>',\n  '<body class=\"min-h-screen\">',\n  '  <main class=\"max-w-7xl mx-auto p-4 lg:p-6 space-y-6\">',\n  '    <div class=\"flex flex-wrap items-center justify-between gap-3\">',\n  '      <div><div class=\"text-xs font-semibold uppercase tracking-wide text-primary\">Case Email</div><h1 class=\"text-3xl font-bold\">Email Preview</h1><p class=\"text-sm text-base-content/60\">Review the rendered case message, update the body, and send it through the shared HTML email path.</p></div>',\n  '      <div class=\"flex items-center gap-3\"><div class=\"badge badge-outline\">' + escapeHtml(modeLabel) + '</div><a class=\"btn btn-ghost\" href=\"' + escapeHtml(item.return_url) + '\">Back to Case</a></div>',\n  '    </div>',\n  '    ' + warningHtml,\n  '    <section class=\"grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]\">',\n  '      <div class=\"card bg-base-100 shadow-sm border border-base-300\">',\n  '        <div class=\"card-body space-y-5\">',\n  '          <div class=\"flex flex-wrap items-start justify-between gap-3\">',\n  '            <div><h2 class=\"card-title\">Compose Email</h2><p class=\"text-sm text-base-content/60\">HTML templates stay editable in TinyMCE. The signature remains separate and is appended during send.</p></div>',\n  '            <div class=\"badge badge-outline\">' + escapeHtml(String(item.email_type || '').toUpperCase() || 'EMAIL') + '</div>',\n  '          </div>',\n  '          <form id=\"compose-form\" class=\"space-y-5\" method=\"POST\" action=\"' + escapeHtml(item.send_url) + '\">',\n  '            <input type=\"hidden\" name=\"case_id\" value=\"' + escapeHtml(item.case_id) + '\">',\n  '            <input type=\"hidden\" name=\"template_key\" value=\"' + escapeHtml(item.template_key) + '\">',\n  '            <input type=\"hidden\" name=\"signature_template_key\" value=\"' + escapeHtml(item.signature_template_key) + '\">',\n  '            <input type=\"hidden\" name=\"email_type\" value=\"' + escapeHtml(item.email_type) + '\">',\n  '            <input type=\"hidden\" name=\"return_url\" value=\"' + escapeHtml(item.return_url) + '\">',\n  '            <textarea id=\"rendered-message-output\" name=\"rendered_message\" class=\"hidden\"></textarea>',\n  '            <label class=\"form-control\"><span class=\"label-text\">Recipient</span><input class=\"input input-bordered\" type=\"email\" name=\"to\" value=\"' + escapeHtml(item.intended_recipient) + '\" required></label>',\n  '            <label class=\"form-control\"><span class=\"label-text\">Subject</span><input class=\"input input-bordered\" type=\"text\" name=\"rendered_subject\" value=\"' + escapeHtml(item.rendered_subject) + '\" required></label>',\n  '            <section class=\"space-y-3\">',\n  '              <div class=\"flex flex-wrap items-center justify-between gap-3\"><div><div class=\"font-medium\">Message</div><div class=\"text-sm text-base-content/60\">' + escapeHtml(item.email_type === 'html' ? 'Use TinyMCE to edit the message body. The signature remains separate and is appended during send.' : 'Edit the message body directly. The signature remains separate and is appended during send.') + '</div></div></div>',\n  '              ' + (item.email_type === 'html'\n    ? '<div class=\"editor-frame\"><div id=\"message-toolbar\"></div><div id=\"message-editor-host\" class=\"editor-inline-host\"></div><textarea id=\"message-editor-input\" class=\"editor-textarea-hidden\"></textarea></div>'\n    : '<textarea id=\"message-editor-input\" class=\"textarea textarea-bordered min-h-[22rem] w-full\"></textarea>'),\n  '            </section>',\n  '            <label class=\"form-control\"><span class=\"label-text\">Signature</span>' + (item.email_type === 'html' ? '<textarea id=\"signature-editor-input\" class=\"textarea textarea-bordered min-h-[10rem] w-full\">' + escapeHtml(item.rendered_signature || '') + '</textarea>' : '<textarea id=\"signature-editor-input\" class=\"textarea textarea-bordered min-h-[10rem] w-full\">' + escapeHtml(item.rendered_signature || '') + '</textarea>') + '</label>',\n  '            <div class=\"flex flex-wrap items-center justify-between gap-4 pt-2\">',\n  '              <label class=\"label cursor-pointer justify-start gap-3\"><input class=\"checkbox\" type=\"checkbox\" name=\"test_mode\" value=\"1\"' + modeChecked + '><span class=\"label-text\">Send in test mode</span></label>',\n  '              <button class=\"btn btn-primary\" type=\"submit\">Send Email</button>',\n  '            </div>',\n  '          </form>',\n  '        </div>',\n  '      </div>',\n  '      <div class=\"space-y-4\">',\n  '        <di