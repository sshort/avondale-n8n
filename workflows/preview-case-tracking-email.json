    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Resolve Preview Request').first()?.json ?? {};\nconst context = $('Load Preview Context').first()?.json ?? {};\nconst parseMaybe = (value, fallback) => {\n  if (value === null || value === undefined || value === '') return fallback;\n  if (typeof value === 'string') { try { return JSON.parse(value); } catch { return fallback; } }\n  return value;\n};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst caseRow = parseMaybe(context.case_row, {}) || {};\nconst imageRows = Array.isArray(parseMaybe(context.image_rows, [])) ? parseMaybe(context.image_rows, []) : [];\nconst applyTokens = (value) => {\n  let rendered = String(value ?? '');\n  const tokenMap = {\n    '{{case_title}}': clean(caseRow.title),\n    '{{case_status}}': clean(caseRow.status),\n    '{{case_priority}}': clean(caseRow.priority),\n    '{{contact_name}}': clean(caseRow.contact_name),\n    '{{contact_email}}': clean(caseRow.contact_email),\n    '{{contact_phone}}': clean(caseRow.contact_phone),\n    '{{today}}': new Date().toLocaleDateString('en-GB'),\n  };\n  for (const [token, replacement] of Object.entries(tokenMap)) rendered = rendered.split(token).join(replacement);\n  return rendered.trim();\n};\nconst hasHtmlTemplate = clean(context.html_template) !== '';\nconst hasTextTemplate = clean(context.text_template) !== '';\nconst emailType = hasHtmlTemplate || !hasTextTemplate ? 'html' : 'text';\nconst renderedSubject = applyTokens(clean(context.subject_template) || 'Update from Avondale Tennis Club');\nconst renderedMessage = applyTokens(emailType === 'html' ? clean(context.html_template) : clean(context.text_template));\nconst renderedSignature = applyTokens(emailType === 'html' ? clean(context.signature_html_template) : clean(context.signature_text_template));\nconst intendedRecipient = clean(input.to) || clean(caseRow.contact_email);\nconst actualRecipient = input.delivery_mode === 'production' ? intendedRecipient : input.test_recipient;\nconst combinedPreviewHtml = emailType === 'html' ? (renderedMessage + renderedSignature) : '';\nconst combinedPreviewText = [renderedMessage, renderedSignature].filter(Boolean).join('\\n\\n');\nreturn [{ json: {\n  case_id: input.case_id,\n  case_title: clean(caseRow.title),\n  template_key: clean(context.template_key),\n  template_name: clean(context.template_name) || 'Custom message',\n  signature_template_key: clean(context.signature_template_key),\n  signature_template_name: clean(context.signature_template_name),\n  return_url: input.return_url,\n  send_url: input.send_url,\n  delivery_mode: input.delivery_mode,\n  sender_name: input.sender_name,\n  reply_to: input.reply_to,\n  test_recipient: input.test_recipient,\n  intended_recipient: intendedRecipient,\n  actual_recipient: actualRecipient,\n  email_type: emailType,\n  rendered_subject: renderedSubject,\n  rendered_message: renderedMessage,\n  rendered_signature: renderedSignature,\n  combined_preview_html: combinedPreviewHtml,\n  combined_preview_text: combinedPreviewText,\n  image_rows: imageRows,\n  image_asset_url_base: input.n8n_base_url + '/webhook/email-image-asset?image_key=',\n  image_actions_url: input.n8n_base_url + '/webhook/email-template-editor-actions',\n  missing_recipient: intendedRecipient ? '' : 'No recipient email is available for this case.',\n} }];"
      },
      "id": "ctc000000-0000-0000-0000-000000000011",
      "name": "Render Preview Data",
