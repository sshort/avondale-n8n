        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const safeJson = (nodeName) => {\n  try {\n    return $(nodeName).first()?.json ?? {};\n  } catch {\n    return {};\n  }\n};\nconst requestInput = safeJson('Resolve Preview Request');\nconst contextRow = safeJson('Load Preview Context');\nconst message = contextRow.error_message || requestInput.error_message || 'Unable to prepare the preview.';\nconst returnUrl = requestInput.return_url || '#';\nconst escapeHtml = (value) => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\\"/g, '&quot;').replace(/'/g, '&#39;');\nconst html = '<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Email preview unavailable</title></head><body><p>' + escapeHtml(message) + '</p><p><a href=\"' + escapeHtml(returnUrl) + '\">Back to case</a></p></body></html>';\nreturn [{ json: { html } }];"
      },
