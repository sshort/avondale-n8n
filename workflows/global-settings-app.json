      ],
      "parameters": {
        "jsCode": "const input=$input.first().json??{}; const sqlLiteral=(v)=>\"'\"+String(v??'').replace(/'/g,\"''\")+\"'\"; let sql; if(input.mode==='edit'){sql=`SELECT (SELECT to_jsonb(s) FROM public.global_settings s WHERE s.key=${sqlLiteral(input.key)}) AS setting, COALESCE((SELECT json_agg(json_build_object('template_key',t.template_key,'template_name',t.template_name) ORDER BY lower(t.template_name)) FROM public.email_templates t WHERE t.is_active=TRUE),'[]'::json) AS template_options`;}else{sql='SELECT COALESCE((SELECT json_agg(to_jsonb(s) ORDER BY s.key) FROM public.global_settings s),\\'[]\\':json) AS settings'; sql=`SELECT COALESCE((SELECT json_agg(to_jsonb(s) ORDER BY s.key) FROM public.global_settings s),'[]'::json) AS settings`;} return [{json:{...input,sql}}];"
