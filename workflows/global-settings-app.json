      ],
      "parameters": {
        "jsCode": "const input=$('Resolve App Request').first()?.json??{}; const row=$('Load Page Data').first()?.json??{}; const parseMaybe=(v,fb)=>{if(v===null||v===undefined||v==='')return fb;if(typeof v==='string'){try{return JSON.parse(v);}catch{return fb;}}return v;}; const clean=(v)=>v===null||v===undefined?'':String(v).trim(); const escapeHtml=(v)=>clean(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;'); const baseUrl=clean(input.n8n_base_url); const appUrl=baseUrl+'/webhook/global-settings'; const actionsUrl=baseUrl+'/webhook/global-settings-actions'; const TYPE_LABELS={text:'Text',number:'Number',url:'URL',json:'JSON',email_template_key:'Template Key',email:'Email',password:'Password'}; const TYPE_BADGES={text:'badge-ghost',number:'badge-info',url:'badge-primary',json:'badge-warning',email_template_key:'badge-secondary',email:'badge-accent',password:'badge-error'}; const VALID_TYPES=Object.keys(TYPE_LABELS); const renderNotice=()=>{if(clean(input.flash_error))return `<div class='alert alert-error shadow-sm mb-4'><span>${escapeHtml(input.flash_error)}</span></div>`;if(clean(input.flash_message))return `<div class='alert alert-success shadow-sm mb-4'><span>${escapeHtml(input.flash_message)}</span></div>`;return '';}; const head=`<!doctype html><html lang='en' data-theme='light'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Global Settings \u2014 Avondale</title><link href='https://cdn.jsdelivr.net/npm/daisyui@5' rel='stylesheet' type='text/css' /><script src='https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4'><\\/script></head><body class='bg-base-200 min-h-screen'>`; const nav=`<div class='navbar bg-base-100/90 backdrop-blur border-b border-base-300 sticky top-0 z-20 px-4'><div class='flex-1'><div><div class='text-xs font-semibold uppercase tracking-wide text-primary'>Avondale</div><h1 class='text-xl font-bold leading-tight'>Global Settings</h1></div></div><div class='flex-none gap-2'><a href='${appUrl}' class='btn btn-ghost btn-sm'>All Settings</a></div></div>`; const renderValuePreview=(type,value)=>{const t=(s,n)=>s.length>n?s.slice(0,n)+'\\u2026':s;if(type==='json'){try{const p=JSON.parse(value);return `<code class='text-xs font-mono opacity-70 break-all'>${escapeHtml(t(JSON.stringify(p),100))}</code>`;}catch{return `<code class='text-xs text-error font-mono break-all'>${escapeHtml(t(value,100))}</code>`;}}if(type==='url')return `<a href='${escapeHtml(value)}' target='_blank' class='link link-primary text-xs font-mono break-all'>${escapeHtml(t(value,80))}</a>`;if(type==='email')return `<a href='mailto:${escapeHtml(value)}' class='link link-accent text-xs font-mono break-all'>${escapeHtml(t(value,80))}</a>`;if(type==='password')return `<span class='text-sm font-mono opacity-40 tracking-widest'>\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022</span>`;return `<span class='text-sm font-mono opacity-70 break-all'>${escapeHtml(t(value,100))}</span>`;}; let bodyHtml; if(input.mode==='edit'){const setting=parseMaybe(row.setting,{})||{};const templateOptions=Array.isArray(parseMaybe(row.template_options,[]))?parseMaybe(row.template_options,[]):[];if(!setting||!clean(setting.key)){bodyHtml=`<div class='p-6'>${renderNotice()}<div class='alert alert-error'><span>Setting not found.</span></div></div>`;}else{const storedType=clean(setting.setting_type)||'text';const effectiveType=VALID_TYPES.includes(clean(input.type_override))?clean(input.type_override):storedType;const value=clean(setting.value);const typeOpts=VALID_TYPES.map(t=>`<option value='${t}'${t===effectiveType?' selected':''}>${TYPE_LABELS[t]}</option>`).join('');let valueInput;if(effectiveType==='number'){valueInput=`<input type='number' name='value' class='input input-bordered input-sm w-full font-mono' value='${escapeHtml(value)}' step='any'>`;}else if(effectiveType==='url'){valueInput=`<input type='url' name='value' class='input input-bordered input-sm w-full font-mono' value='${escapeHtml(value)}' placeholder='https://'>`;}else if(effectiveType==='json'){const pretty=(()=>{try{return JSON.stringify(JSON.parse(value),null,2);}catch{return value;}})();valueInput=`<textarea name='value' class='textarea textarea-bordered textarea-sm w-full font-mono min-h-64' rows='16' spellcheck='false'>${escapeHtml(pretty)}</textarea><p class='text-xs text-base-content/60 mt-1'>Must be valid JSON.</p>`;}else if(effectiveType==='email_template_key'){const opts=templateOptions.map(t=>`<option value='${escapeHtml(t.template_key)}'${t.template_key===value?' selected':''}>${escapeHtml(t.template_name)} (${escapeHtml(t.template_key)})</option>`).join('');valueInput=`<select name='value' class='select select-bordered select-sm w-full font-mono'><option value=''>\\u2014 select a template \\u2014</option>${opts}</select>`;}else if(effectiveType==='email'){valueInput=`<input type='email' name='value' class='input input-bordered input-sm w-full font-mono' value='${escapeHtml(value)}' placeholder='address@example.com'>`;}else if(effectiveType==='password'){const eyeOpen=\"<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor' class='w-4 h-4'><path stroke-linecap='round' stroke-linejoin='round' d='M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z'/><path stroke-linecap='round' stroke-linejoin='round' d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'/></svg>\";const eyeOff=\"<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor' class='w-4 h-4'><path stroke-linecap='round' stroke-linejoin='round' d='M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88'/></svg>\";valueInput=`<div class='relative'><input type='password' id='pwd-value' name='value' class='input input-bordered input-sm w-full font-mono pr-10' value='${escapeHtml(value)}' autocomplete='off'><button type='button' id='pwd-toggle' class='absolute right-2 top-1/2 -translate-y-1/2 btn btn-ghost btn-xs btn-square opacity-60 hover:opacity-100' title='Show/hide'>${eyeOpen}</button></div><script>document.getElementById('pwd-toggle').addEventListener('click',function(){var i=document.getElementById('pwd-value');var show=i.type==='password';i.type=show?'text':'password';this.innerHTML=show?${JSON.stringify(eyeOff)}:${JSON.stringify(eyeOpen)};});<\\/script>`;}else{valueInput=value.length>80||value.includes('\\n')?`<textarea name='value' class='textarea textarea-bordered textarea-sm w-full font-mono' rows='4'>${escapeHtml(value)}</textarea>`:`<input type='text' name='value' class='input input-bordered input-sm w-full font-mono' value='${escapeHtml(value)}'>`;}const typeSwitchUrl=`${appUrl}?key=${encodeURIComponent(setting.key)}&type=`;bodyHtml=`<div class='p-4 lg:p-6'>${renderNotice()}<div class='max-w-2xl'><a href='${appUrl}' class='btn btn-ghost btn-xs mb-4'>\\u2190 All settings</a><div class='card bg-base-100 shadow-sm border border-base-300'><div class='card-body'><div class='mb-4'><code class='text-lg font-bold font-mono'>${escapeHtml(setting.key)}</code><p class='text-sm text-base-content/60 mt-1'>${escapeHtml(clean(setting.description))}</p></div><form method='POST' action='${actionsUrl}' class='space-y-5'><input type='hidden' name='action' value='update_setting'><input type='hidden' name='key' value='${escapeHtml(setting.key)}'><input type='hidden' name='return_url' value='${escapeHtml(appUrl)}?key=${encodeURIComponent(setting.key)}'><div class='form-control'><label class='label pb-1'><span class='label-text font-medium'>Type</span></label><select name='type' class='select select-bordered select-sm w-full max-w-xs' onchange='window.location.href=${JSON.stringify(typeSwitchUrl)}+encodeURIComponent(this.value)'>${typeOpts}</select><p class='text-xs text-base-content/60 mt-1'>Switching type reloads this form without saving. Click Save to persist both type and value.</p></div><div class='form-control'><label class='label pb-1'><span class='label-text font-medium'>Value</span></label>${valueInput}</div><div class='form-control'><label class='label pb-1'><span class='label-text font-medium'>Description</span></label><input type='text' name='description' class='input input-bordered input-sm w-full' value='${escapeHtml(clean(setting.description))}'></div><div class='flex gap-3 pt-2'><button class='btn btn-primary btn-sm' type='submit'>Save</button><a class='btn btn-ghost btn-sm' href='${appUrl}'>Cancel</a></div></form></div></div></div></div>`;}}else{const settings=Array.isArray(parseMaybe(row.settings,[]))?parseMaybe(row.settings,[]):[];const tableRows=settings.map(s=>{const type=clean(s.setting_type)||'text';const badge=TYPE_BADGES[type]||'badge-ghost';const label=TYPE_LABELS[type]||type;return `<tr data-key='${escapeHtml(s.key.toLowerCase())}'><td class='align-top py-3'><code class='text-sm font-mono font-semibold'>${escapeHtml(s.key)}</code></td><td class='align-top py-3'><span class='badge ${badge} badge-sm whitespace-nowrap'>${escapeHtml(label)}</span></td><td class='align-top py-3 max-w-xs'>${renderValuePreview(type,clean(s.value))}</td><td class='align-top py-3 text-sm text-base-content/60 max-w-xs'>${escapeHtml(clean(s.description))}</td><td class='align-top py-3 text-right'><a href='${appUrl}?key=${encodeURIComponent(s.key)}' class='btn btn-ghost btn-xs'>Edit</a></td></tr>`;}).join('');bodyHtml=`<div class='p-4 lg:p-6'>${renderNotice()}<div class='card bg-base-100 shadow-sm border border-base-300'><div class='card-body'><div class='flex items-center gap-4 mb-4'><h2 class='card-title'>All settings <span class='badge badge-neutral badge-sm'>${settings.length}</span></h2><input type='text' id='key-filter' placeholder='Filter by key\u2026' class='input input-bordered input-sm w-full max-w-xs' oninput='filterSettings(this.value)'></div><div class='overflow-x-auto'><table class='table table-sm'><thead><tr><th>Key</th><th>Type</th><th>Value</th><th>Description</th><th></th></tr></thead><tbody>${tableRows||`<tr><td colspan='5' class='text-center text-base-content/50 py-6'>No settings found.</td></tr>`}</tbody></table></div></div></div></div>`;} const filterScript=input.mode==='list'?`<script>function filterSettings(q){const lq=q.toLowerCase();document.querySelectorAll('tbody tr[data-key]').forEach(r=>{r.style.display=r.dataset.key.includes(lq)?'':'none';});}<\\/script>`:''; const html=head+nav+bodyHtml+filterScript+'</body></html>'; return [{json:{html}}];"
      }
