      ],
      "parameters": {
        "jsCode": "const request=$('Global Settings App Webhook').first()?.json??$input.first()?.json??{}; const query=request.query??request; const headers=request.headers??{}; const settings=$('Load App Settings').first()?.json??{}; const clean=(v)=>v===null||v===undefined?'':String(v).trim(); const deriveBaseUrl=(h,fb)=>{const fp=clean(h['x-forwarded-proto']);const fh=clean(h['x-forwarded-host']);const host=fh||clean(h.host);if(!host)return fb;const proto=fp||'http';let a=host;const fport=clean(h['x-forwarded-port']);if(fport&&!a.includes(':')){const def=(proto==='http'&&fport==='80')||(proto==='https'&&fport==='443');if(!def)a=a+':'+fport;}return proto+'://'+a;}; const fallbackBaseUrl=clean(settings.n8n_base_url)||'http://n8n:5678'; const n8nBaseUrl=deriveBaseUrl(headers,fallbackBaseUrl); const key=clean(query.key); const typeOverride=clean(query.type); return [{json:{key,type_override:typeOverride,mode:key?'edit':'list',flash_message:clean(query.message),flash_error:clean(query.error),n8n_base_url:n8nBaseUrl}}];"
      }
