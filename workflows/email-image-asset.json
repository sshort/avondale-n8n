      "name": "Email Image Asset Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 140],
      "webhookId": "email-image-asset"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const request = $('Email Image Asset Webhook').first()?.json ?? $input.first()?.json ?? {};\nconst query = request.query ?? request ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst imageKey = clean(query.image_key || query.imageKey || query.key);\nconst sqlLiteral = (value) => \"'\" + String(value ?? '').replace(/'/g, \"''\") + \"'\";\nconst errorMessage = imageKey ? '' : 'image_key is required';\nconst sql = imageKey\n  ? [\n      'WITH selected AS (',\n      \"  SELECT image_key, file_name, file_ext, content_type, encode(data, 'base64') AS data_base64\",\n      '  FROM public.images',\n      '  WHERE is_active = true',\n      '    AND image_key = ' + sqlLiteral(imageKey),\n      '  ORDER BY id DESC',\n      '  LIMIT 1',\n      ')',\n      'SELECT',\n      \"  COALESCE((SELECT image_key FROM selected), '') AS image_key,\",\n      \"  COALESCE((SELECT file_name FROM selected), '') AS file_name,\",\n      \"  COALESCE((SELECT file_ext FROM selected), '') AS file_ext,\",\n      \"  COALESCE((SELECT content_type FROM selected), '') AS content_type,\",\n      \"  COALESCE((SELECT data_base64 FROM selected), '') AS data_base64;\"\n    ].join('\\n')\n  : \"SELECT ''::text AS image_key, ''::text AS file_name, ''::text AS file_ext, ''::text AS content_type, ''::text AS data_base64;\";\nreturn [{ json: { image_key: imageKey, error_message: errorMessage, sql } }];"
      },
      "id": "eia000000-0000-0000-0000-000000000003",
      "name": "Resolve Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 220]
    },
    {
      "parameters": {
