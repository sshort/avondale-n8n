          },
          "conditions": [
            {
              "id": "eia000000-0000-0000-0000-000000000004-condition",
              "leftValue": "={{ $json.error_message || \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
