      "id": "eia000000-0000-0000-0000-000000000005a",
      "name": "Check Image Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1270, 320]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const requestInput = $('Resolve Request').first()?.json ?? {};\nconst row = $('Load Image').first()?.json ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst found = clean(row.image_key) !== '' && clean(row.data_base64) !== '';\nconst errorMessage = clean(requestInput.error_message) || (found ? '' : `Managed image '${clean(requestInput.image_key)}' was not found`);\nreturn [{ json: { image_key: requestInput.image_key || '', error_message: errorMessage, response_code: clean(requestInput.error_message) ? 400 : 404 } }];"
      },
      "id": "eia000000-0000-0000-0000-000000000006",
      "name": "Build Error JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: $json.error_message, image_key: $json.image_key || '' } }}",
        "options": {
          "responseCode": "={{ Number($json.response_code || 404) }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "Cache-Control",
                "value": "private, no-store, no-cache, must-revalidate, max-age=0"
              },
              {
                "name": "Pragma",
                "value": "no-cache"
              },
              {
                "name": "Expires",
                "value": "0"
              }
            ]
          }
        }
      },
      "id": "eia000000-0000-0000-0000-000000000007",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1540, 140]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = $('Load Image').first()?.json ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst fileName = clean(row.file_name) || clean(row.image_key) || 'image.bin';\nconst extension = clean(row.file_ext || ((fileName.match(/\\.([^.]+)$/) || [])[1]) || 'bin').toLowerCase();\nreturn [{\n  json: {\n    image_key: clean(row.image_key),\n    content_type: clean(row.content_type) || 'application/octet-stream',\n    file_name: fileName\n  },\n  binary: {\n    data: {\n      data: clean(row.data_base64),\n      mimeType: clean(row.content_type) || 'application/octet-stream',\n      fileName,\n      fileExtension: extension || 'bin'\n    }\n  }\n}];"
      },
      "id": "eia000000-0000-0000-0000-000000000008",
      "name": "Build Binary Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 320]
    },
