    {
      "parameters": {
        "jsCode": "var input=$('Resolve Page Request').first().json||{};var rows=$('List Refunds SQL').all().map(function(i){return i.json});var tmpl=$('Load HTML Template').first().json.html_template||'';var C=function(v){return v==null?'':String(v).trim()};var M=function(v){if(!v&&v!==0)return'';var n=parseFloat(v);return isNaN(n)?'':'£'+n.toFixed(2)};var B=function(s){var x=C(s).toLowerCase();if(x.indexOf('processed')>=0||x.indexOf('paid')>=0)return's';if(x.indexOf('bank')>=0)return'w';return''};var data=rows.map(function(r){return{id:r.id,name:C(r.name),mem:C(r.membership),reason:C(r.reason),amt:M(r.amount),refundAmt:M(r.refund),status:C(r.status),cls:B(r.status)}});var h='<h1>Refunds ('+data.length+')</h1>';if(input.error)h+='<div style=\"background:#fee2e2;padding:12px\">'+input.error+'</div>';if(input.message)h+='<div style=\"background:#dcfce7;padding:12px\">'+input.message+'</div>';if(data.length>0){h+='<table style=\"width:100%;border-collapse:collapse;background:#fff\"><thead><tr><th style=\"padding:12px;background:#f9f9f9\">ID</th><th style=\"padding:12px;background:#f9f9f9\">Name</th><th style=\"padding:12px;background:#f9f9f9\">Member</th><th style=\"padding:12px;background:#f9f9f9\">Reason</th><th style=\"padding:12px;background:#f9f9f9\">Amount</th><th style=\"padding:12px;background:#f9f9f9\">Refund</th><th style=\"padding:12px;background:#f9f9f9\">Status</th></tr></thead><tbody>';h+=data.map(function(r){var bg=r.cls=='s'?'background:#dcfce7':(r.cls=='w'?'background:#fef3c7':'');return'<tr><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.id+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.name+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.mem+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.reason+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.amt+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.refundAmt+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\"><span style=\"padding:4px 8px;border-radius:4px;font-size:12px;'+bg+'\">'+r.status+'</span></td></tr>'}).join('');h+='</tbody></table>'}else{h+='<p>No refunds</p>'};var html=tmpl.replace('{{content}}',h);return[{json:{html:html}}];"
      },
