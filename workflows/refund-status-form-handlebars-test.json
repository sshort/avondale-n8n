          "id": "PjTUDAMk0dZ7g1iO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var src=$input.first().json||{};var q=src.query||src;var h=src.headers||{host:'localhost:5678'};var s=$('Load Global Settings').first().json||{};var clean=function(v){return v==null?'':String(v).trim()};var id=Number.parseInt(clean(q.id),10);return[{json:{n8n_base_url:h.host||s.n8n_base_url||'http://localhost:5678',selected_id:isNaN(id)?null:id,message:clean(q.message),error:clean(q.error)}}];"
      },
      "id": "t4",
      "name": "Resolve Page Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id,name,refund_for,membership,reason,amount,refund,status FROM public.refunds ORDER BY id DESC LIMIT 100;"
      },
      "id": "t5",
      "name": "List Refunds SQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        620
      ],
      "credentials": {
        "postgres": {
          "id": "PjTUDAMk0dZ7g1iO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT html_template FROM public.html_templates WHERE template_name = 'refund-status-list' AND is_active = true ORDER BY id DESC LIMIT 1;"
      },
      "id": "t5b",
      "name": "Load HTML Template",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        420
      ],
      "credentials": {
        "postgres": {
          "id": "PjTUDAMk0dZ7g1iO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var input=$('Resolve Page Request').first().json||{};var rows=$('List Refunds SQL').all().map(function(i){return i.json});var tmpl=$('Load HTML Template').first().json.html_template||'';var C=function(v){return v==null?'':String(v).trim()};var M=function(v){if(!v&&v!==0)return'';var n=parseFloat(v);return isNaN(n)?'':'\u00a3'+n.toFixed(2)};var B=function(s){var x=C(s).toLowerCase();if(x.indexOf('processed')>=0||x.indexOf('paid')>=0)return's';if(x.indexOf('bank')>=0)return'w';return''};var data=rows.map(function(r){return{id:r.id,name:C(r.name),mem:C(r.membership),reason:C(r.reason),amt:M(r.amount),refundAmt:M(r.refund),status:C(r.status),cls:B(r.status)}});var h='<h1>Refunds ('+data.length+')</h1>';if(input.error)h+='<div style=\"background:#fee2e2;padding:12px\">'+input.error+'</div>';if(input.message)h+='<div style=\"background:#dcfce7;padding:12px\">'+input.message+'</div>';if(data.length>0){h+='<table style=\"width:100%;border-collapse:collapse;background:#fff\"><thead><tr><th style=\"padding:12px;background:#f9f9f9\">ID</th><th style=\"padding:12px;background:#f9f9f9\">Name</th><th style=\"padding:12px;background:#f9f9f9\">Member</th><th style=\"padding:12px;background:#f9f9f9\">Reason</th><th style=\"padding:12px;background:#f9f9f9\">Amount</th><th style=\"padding:12px;background:#f9f9f9\">Refund</th><th style=\"padding:12px;background:#f9f9f9\">Status</th></tr></thead><tbody>';h+=data.map(function(r){var bg=r.cls=='s'?'background:#dcfce7':(r.cls=='w'?'background:#fef3c7':'');return'<tr><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.id+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.name+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.mem+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.reason+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.amt+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\">'+r.refundAmt+'</td><td style=\"padding:12px;border-bottom:1px solid #ddd\"><span style=\"padding:4px 8px;border-radius:4px;font-size:12px;'+bg+'\">'+r.status+'</span></td></tr>'}).join('');h+='</tbody></table>'}else{h+='<p>No refunds</p>'};var html=tmpl.replace('{{content}}',h);return[{json:{html:html}}];"
      },
