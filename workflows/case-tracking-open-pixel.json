    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const transparentGif = 'R0lGODlhAQABAPAAAAAAAAAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==';\nconst updatedRows = Number($('Update Open Status').first()?.json?.updated_rows ?? 0);\nreturn [{\n  json: {\n    updated_rows: updatedRows,\n  },\n  binary: {\n    data: {\n      data: transparentGif,\n      mimeType: 'image/gif',\n      fileName: 'asset.gif',\n      fileExtension: 'gif'\n    }\n  }\n}];"
      },
