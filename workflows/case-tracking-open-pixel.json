    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const request = $('Open Pixel Webhook').first()?.json ?? $input.first()?.json ?? {};\nconst query = request.query ?? request ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst token = clean(query.v);\nconst sqlLiteral = (value) => \"'\" + String(value ?? '').replace(/'/g, \"''\") + \"'\";\nconst sql = token\n  ? [\n      'WITH matched AS (',\n      '  SELECT id',\n      '  FROM public.case_emails',\n      '  WHERE open_tracking_enabled IS TRUE',\n      '    AND open_tracking_token = ' + sqlLiteral(token),\n      '  LIMIT 1',\n      '), updated AS (',\n      '  UPDATE public.case_emails',\n      '  SET open_count = COALESCE(open_count, 0) + 1,',\n      '      first_opened_at = COALESCE(first_opened_at, now()),',\n      '      last_opened_at = now(),',\n      \"      open_tracking_status = 'Opened'\",\n      '  WHERE id IN (SELECT id FROM matched)',\n      '  RETURNING id',\n      ')',\n      'SELECT COUNT(*)::bigint AS updated_rows FROM updated;'\n    ].join('\\n')\n  : 'SELECT 0::bigint AS updated_rows;';\nreturn [{ json: { sql, token_present: Boolean(token) } }];"
      },
      "id": "cto000000-0000-0000-0000-000000000003",
      "name": "Build Open Tracking SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        220
      ]
    },
