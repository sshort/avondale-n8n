      "id": "mlo000000-0000-0000-0000-000000000001",
      "name": "Open Pixel Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        220
      ],
      "webhookId": "member-list-mailout-open-pixel"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const request = $('Open Pixel Webhook').first()?.json ?? $input.first()?.json ?? {};\nconst query = request.query ?? request ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst token = clean(query.v);\nconst isValidUuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(token);\nconst sqlLiteral = (value) => \"'\" + String(value ?? '').replace(/'/g, \"''\") + \"'\";\nconst sql = (token && isValidUuid)\n  ? [\n      'UPDATE public.member_list_mailout_recipients',\n      'SET open_count = open_count + 1,',\n      '    first_opened_at = COALESCE(first_opened_at, now()),',\n      '    last_opened_at = now(),',\n      \"    open_status = 'Opened'\",\n      'WHERE open_tracking_token = ' + sqlLiteral(token) + '::uuid',\n      '  AND open_tracking_enabled = TRUE'\n    ].join('\\n')\n  : 'SELECT 0 AS skipped';\nreturn [{ json: { sql, token_present: Boolean(token), token_valid: isValidUuid } }];"
      },
      "id": "mlo000000-0000-0000-0000-000000000002",
      "name": "Build Open Tracking SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}"
      },
      "id": "mlo000000-0000-0000-0000-000000000003",
      "name": "Update Open Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "PjTUDAMk0dZ7g1iO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const transparentGif = 'R0lGODlhAQABAPAAAAAAAAAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==';\nreturn [{\n  json: { ok: true },\n  binary: {\n    data: {\n      data: transparentGif,\n      mimeType: 'image/gif',\n      fileName: 'asset.gif',\n      fileExtension: 'gif'\n    }\n  }\n}];"
      },
      "id": "mlo000000-0000-0000-0000-000000000004",
      "name": "Build Transparent GIF",
