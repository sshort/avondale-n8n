          }
        },
        "lib/type": "mbql.stage/native",
        "native": "WITH settings AS (\n  SELECT COALESCE(MAX(CASE WHEN key = 'n8n_base_url' THEN value END), 'http://n8n:5678') AS n8n_base_url\n  FROM public.global_settings\n),\nprev_rows AS (\n  SELECT\n    m.id AS raw_member_id,\n    settings.n8n_base_url,\n    trim(concat_ws(' ', m.\"First name\", m.\"Last name\")) AS member_name,\n    lower(trim(concat_ws(' ', m.\"First name\", m.\"Last name\"))) AS name_key,\n    NULLIF(lower(trim(COALESCE(m.\"Email address\", ''))), '') AS email_key,\n    NULLIF(trim(COALESCE(m.\"Venue ID\", '')), '') AS venue_id,\n    NULLIF(trim(COALESCE(m.\"British Tennis Number\", '')), '') AS btn,\n    m.\"Email address\" AS email_address,\n    m.\"Membership\" AS membership,\n    p.category,\n    p.display_order,\n    COALESCE(m.\"Cost\", 0) AS member_cost,\n    (({{year}})::int - 1)::text AS season_year\n  FROM public.raw_members m\n  JOIN public.membership_packages p\n    ON m.\"Membership\" = p.name\n   AND p.season = (({{year}})::int - 1)::text\n  CROSS JOIN settings\n  WHERE p.category NOT IN ('Pavilion Key', 'Honorary')\n    AND m.\"Status\" = 'Active'\n),\ncurr_rows AS (\n  SELECT\n    m.id AS raw_member_id,\n    settings.n8n_base_url,\n    trim(concat_ws(' ', m.\"First name\", m.\"Last name\")) AS member_name,\n    lower(trim(concat_ws(' ', m.\"First name\", m.\"Last name\"))) AS name_key,\n    NULLIF(lower(trim(COALESCE(m.\"Email address\", ''))), '') AS email_key,\n    NULLIF(trim(COALESCE(m.\"Venue ID\", '')), '') AS venue_id,\n    NULLIF(trim(COALESCE(m.\"British Tennis Number\", '')), '') AS btn,\n    m.\"Email address\" AS email_address,\n    m.\"Membership\" AS membership,\n    p.category,\n    p.display_order,\n    COALESCE(m.\"Cost\", 0) AS member_cost,\n    ({{year}})::text AS season_year\n  FROM public.raw_members m\n  JOIN public.membership_packages p\n    ON m.\"Membership\" = p.name\n   AND p.season = ({{year}})::text\n  CROSS JOIN settings\n  WHERE p.category NOT IN ('Pavilion Key', 'Honorary')\n    AND m.\"Status\" = 'Active'\n),\nprev_members AS (\n  SELECT DISTINCT ON (COALESCE(email_key, venue_id, btn, name_key))\n    COALESCE(email_key, venue_id, btn, name_key) AS dedupe_key,\n    raw_member_id AS previous_raw_member_id,\n    n8n_base_url,\n    member_name,\n    name_key,\n    email_key,\n    venue_id,\n    btn,\n    email_address AS previous_email_address,\n    membership AS previous_membership,\n    category AS previous_category,\n    season_year AS previous_season_year,\n    member_cost\n  FROM prev_rows\n  ORDER BY COALESCE(email_key, venue_id, btn, name_key), member_cost DESC, raw_member_id DESC, display_order, membership\n),\ncurr_members AS (\n  SELECT DISTINCT ON (COALESCE(email_key, venue_id, btn, name_key))\n    COALESCE(email_key, venue_id, btn, name_key) AS dedupe_key,\n    raw_member_id AS current_raw_member_id,\n    n8n_base_url,\n    member_name AS current_name,\n    name_key,\n    email_key,\n    venue_id,\n    btn,\n    email_address AS current_email_address,\n    membership AS current_membership,\n    category AS current_category,\n    season_year AS current_season_year,\n    member_cost\n  FROM curr_rows\n  ORDER BY COALESCE(email_key, venue_id, btn, name_key), member_cost DESC, raw_member_id DESC, display_order, membership\n),\nmatched_pairs AS (\n  SELECT\n    p.previous_raw_member_id,\n    c.current_raw_member_id,\n    COALESCE(c.n8n_base_url, p.n8n_base_url) AS n8n_base_url,\n    COALESCE(c.current_name, p.member_name) AS member_name,\n    p.previous_category,\n    p.previous_membership,\n    c.current_category,\n    c.current_membership,\n    COALESCE(c.current_email_address, p.previous_email_address) AS email_address,\n    TRUE AS is_previous_year_member\n  FROM prev_members p\n  LEFT JOIN LATERAL (\n    SELECT c.*\n    FROM curr_members c\n    WHERE (\n  (p.email_key IS NOT NULL AND c.email_key = p.email_key)\n  OR (p.venue_id IS NOT NULL AND c.venue_id = p.venue_id)\n  OR (p.btn IS NOT NULL AND c.btn = p.btn)\n  OR (((COALESCE(p.email_key, p.venue_id, p.btn) IS NULL) OR (COALESCE(c.email_key, c.venue_id, c.btn) IS NULL)) AND c.name_key = p.name_key)\n)\n    ORDER BY CASE\n  WHEN p.email_key IS NOT NULL AND c.email_key = p.email_key THEN 1\n  WHEN p.venue_id IS NOT NULL AND c.venue_id = p.venue_id THEN 2\n  WHEN p.btn IS NOT NULL AND c.btn = p.btn THEN 3\n  WHEN ((COALESCE(p.email_key, p.venue_id, p.btn) IS NULL) OR (COALESCE(c.email_key, c.venue_id, c.btn) IS NULL)) AND c.name_key = p.name_key THEN 4\n  ELSE 99\nEND, c.member_cost DESC, c.current_raw_member_id DESC\n    LIMIT 1\n  ) c ON TRUE\n),\nunmatched_current AS (\n  SELECT\n    NULL::integer AS previous_raw_member_id,\n    c.current_raw_member_id,\n    c.n8n_base_url,\n    c.current_name AS member_name,\n    NULL::text AS previous_category,\n    NULL::text AS previous_membership,\n    c.current_category,\n    c.current_membership,\n    c.current_email_address AS email_address,\n    FALSE AS is_previous_year_member\n  FROM curr_members c\n  WHERE NOT EXISTS (\n    SELECT 1\n    FROM prev_members p\n    WHERE (\n  (p.email_key IS NOT NULL AND c.email_key = p.email_key)\n  OR (p.venue_id IS NOT NULL AND c.venue_id = p.venue_id)\n  OR (p.btn IS NOT NULL AND c.btn = p.btn)\n  OR (((COALESCE(p.email_key, p.venue_id, p.btn) IS NULL) OR (COALESCE(c.email_key, c.venue_id, c.btn) IS NULL)) AND c.name_key = p.name_key)\n)\n  )\n),\nmember_matrix AS (\n  SELECT\n    COALESCE(previous_category, current_category) AS row_category,\n    CASE\n      WHEN previous_raw_member_id IS NULL AND current_raw_member_id IS NOT NULL THEN 'New'\n      WHEN current_raw_member_id IS NULL THEN 'Not Renewed'\n      ELSE current_category\n    END AS transition_category,\n    is_previous_year_member,\n    previous_raw_member_id,\n    current_raw_member_id,\n    n8n_base_url,\n    member_name,\n    COALESCE(previous_category, 'New') AS previous_category,\n    COALESCE(previous_membership, 'New') AS previous_membership,\n    COALESCE(current_category, 'Not Renewed') AS current_category,\n    COALESCE(current_membership, 'Not Renewed') AS current_membership,\n    email_address\n  FROM matched_pairs\n  UNION ALL\n  SELECT\n    current_category AS row_category,\n    'New' AS transition_category,\n    is_previous_year_member,\n    previous_raw_member_id,\n    current_raw_member_id,\n    n8n_base_url,\n    member_name,\n    'New' AS previous_category,\n    'New' AS previous_membership,\n    current_category,\n    current_membership,\n    email_address\n  FROM unmatched_current\n)\nSELECT\n  COALESCE(current_raw_member_id, previous_raw_member_id) AS raw_member_id,\n  n8n_base_url,\n  ({{year}})::text AS filter_year,\n  row_category,\n  transition_category,\n  CASE WHEN is_previous_year_member THEN 'Total Previous Year' ELSE NULL END AS previous_total_bucket,\n  member_name AS \"Name\",\n  previous_category AS \"Previous Category\",\n  previous_membership AS \"Previous Membership\",\n  current_category AS \"Current Category\",\n  current_membership AS \"Current Membership\",\n  email_address AS \"Email address\"\nFROM member_matrix\nWHERE 1 = 1\n[[AND row_category = {{row_category}}]]\n[[AND (\n  ({{transition_category}} = 'Total Previous Year' AND is_previous_year_member)\n  OR ({{transition_category}} <> 'Total Previous Year' AND transition_category = {{transition_category}})\n)]]\nORDER BY \"Name\";"
      }
    ]
  },
