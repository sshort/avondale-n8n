    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Resolve Preview Request').first()?.json ?? {};\nconst context = $('Load Preview Context').first()?.json ?? {};\nconst parseMaybe = (value, fallback) => {\n  if (value === null || value === undefined || value === '') return fallback;\n  if (typeof value === 'string') { try { return JSON.parse(value); } catch { return fallback; } }\n  return value;\n};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst caseRow = parseMaybe(context.case_row, {}) || {};\nconst applyTokens = (value) => {\n  let rendered = String(value ?? '');\n  const tokenMap = { '{{case_title}}': clean(caseRow.title), '{{case_status}}': clean(caseRow.status), '{{case_priority}}': clean(caseRow.priority), '{{contact_name}}': clean(caseRow.contact_name), '{{contact_email}}': clean(caseRow.contact_email), '{{contact_phone}}': clean(caseRow.contact_phone), '{{today}}': new Date().toLocaleDateString('en-GB') };\n  for (const [token, replacement] of Object.entries(tokenMap)) rendered = rendered.split(token).join(replacement);\n  return rendered.trim();\n};\nconst hasHtmlContent = Boolean(clean(context.html_template) || clean(context.signature_html_template));\nconst emailType = hasHtmlContent ? 'html' : 'text';\nconst renderedSubject = applyTokens(clean(context.subject_template) || (clean(context.template_key) ? 'Update from Avondale Tennis Club' : ''));\nconst renderedMessage = applyTokens(emailType === 'html' ? clean(context.html_template) : clean(context.text_template));\nconst renderedSignature = applyTokens(emailType === 'html' ? clean(context.signature_html_template) : clean(context.signature_text_template));\nconst intendedRecipient = clean(input.to) || clean(caseRow.contact_email);\nconst actualRecipient = input.delivery_mode === 'production' ? intendedRecipient : input.test_recipient;\nconst combinedPreviewHtml = emailType === 'html' ? (renderedMessage + renderedSignature) : '';\nreturn [{ json: { case_id: input.case_id, case_title: clean(caseRow.title), template_key: clean(context.template_key), template_name: clean(context.template_name), signature_template_key: clean(context.signature_template_key), signature_template_name: clean(context.signature_template_name), return_url: input.return_url, send_url: input.send_url, delivery_mode: input.delivery_mode, sender_name: input.sender_name, reply_to: input.reply_to, test_recipient: input.test_recipient, intended_recipient: intendedRecipient, actual_recipient: actualRecipient, email_type: emailType, rendered_subject: renderedSubject, rendered_message: renderedMessage, rendered_signature: renderedSignature, combined_preview_html: combinedPreviewHtml, missing_recipient: intendedRecipient ? '' : 'No recipient email is available for this case.' } }];"
