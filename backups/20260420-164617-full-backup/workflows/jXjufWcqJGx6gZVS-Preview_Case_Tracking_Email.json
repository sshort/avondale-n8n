        "language": "javaScript",
        "jsCode": "const item = $('Render Preview Data').first()?.json ?? {};\nconst clean = (value) => value === null || value === undefined ? '' : String(value).trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\nconst toScriptString = (value) => JSON.stringify(String(value ?? '')).replace(/<\\/script/gi, '<\\\\/script');\nconst modeChecked = item.delivery_mode === 'production' ? '' : ' checked';\nconst previewPanel = item.email_type === 'html'\n  ? '<div class=\"card bg-base-100 shadow-sm border border-base-300\"><div class=\"card-body\"><h2 class=\"card-title\">Rendered preview</h2><div id=\"rendered-preview-surface\" class=\"preview-surface\">' + String(item.combined_preview_html || '') + '</div></div></div>'\n  : '<div class=\"card bg-base-100 shadow-sm border border-base-300\"><div class=\"card-body\"><h2 class=\"card-title\">Rendered preview</h2><pre id=\"rendered-preview-text\" class=\"preview-text\">' + escapeHtml([item.rendered_message, item.rendered_signature].filter(Boolean).join('\\n\\n')) + '</pre></div></div>';\nconst warningHtml = item.missing_recipient ? '<div class=\"alert alert-warning shadow-sm\"><span>' + escapeHtml(item.missing_recipient) + '</span></div>' : '';\nconst initialMessageHtmlLiteral = toScriptString(item.email_type === 'html' ? item.rendered_message : '');\nconst initialMessageTextLiteral = toScriptString(item.email_type === 'html' ? '' : item.rendered_message);\nconst initialSignatureHtmlLiteral = toScriptString(item.email_type === 'html' ? item.rendered_signature : '');\nconst initialSignatureTextLiteral = toScriptString(item.email_type === 'html' ? '' : item.rendered_signature);\nconst initialMessageHtmlEscaped = escapeHtml(item.email_type === 'html' ? item.rendered_message : '');\nconst initialSignatureHtmlEscaped = escapeHtml(item.email_type === 'html' ? item.rendered_signature : '');\nconst initialMessageTextEscaped = escapeHtml(item.email_type === 'html' ? '' : item.rendered_message);\nconst initialSignatureTextEscaped = escapeHtml(item.email_type === 'html' ? '' : item.rendered_signature);\nconst defaultModeLiteral = toScriptString(item.email_type === 'html' ? 'rich' : 'text');\nconst html = [\n  '<!doctype html>',\n  '<html lang=\"en\">',\n  '<head>',\n  '  <meta charset=\"utf-8\">',\n  '  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">',\n  '  <title>Email preview</title>',\n  '  <link href=\"https://cdn.jsdelivr.net/npm/daisyui@5\" rel=\"stylesheet\" type=\"text/css\" />',\n  '  <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>',\n  '  <style>',\n  '    body { background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%); }',\n  '    .editor-frame { width: min(92%, 54rem); max-width: 100%; min-width: min(100%, 34rem); height: 22rem; min-height: 22rem; resize: both; overflow: hidden; display: flex; flex-direction: column; align-self: flex-start; border: 1px solid oklch(var(--b3)); border-radius: 1rem; background: white; }',\n  '    .editor-panel { flex: 1 1 auto; min-height: 0; height: 100%; display: flex; overflow: hidden; }',\n  '    .editor-panel.hidden { display: none !important; }',\n  '    .editor-toolbar { flex: 0 0 auto; padding: .5rem; border-bottom: 1px solid oklch(var(--b3)); background: color-mix(in oklab, oklch(var(--b2)) 85%, white); }',\n  '    .editor-toolbar.hidden { display: none !important; }',\n  '    .editor-rich-editor { flex: 1 1 auto; min-height: 0; height: 100%; padding: .9rem; overflow: auto; }',\n  '    .editor-rich-editor:focus { outline: none; }',\n  '    .editor-source { flex: 1 1 auto; display: block; width: 100%; height: auto; min-height: 0; padding: 1rem; resize: none; border: 0; outline: none; background: transparent; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .875rem; overflow: auto; }',\n  '    .preview-surface { min-height: 12rem