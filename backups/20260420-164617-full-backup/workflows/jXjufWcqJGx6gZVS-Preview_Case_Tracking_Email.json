    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Resolve Preview Request').first()?.json ?? {};\nconst sqlLiteral = (value) => \"'\" + String(value ?? '').replace(/'/g, \"''\") + \"'\";\nconst sql = [\n  'WITH selected_case AS (',\n  '  SELECT * FROM public.cases WHERE id = ' + sqlLiteral(input.case_id) + '::uuid',\n  '), message_template AS (',\n  '  SELECT template_key, template_name, subject_template, text_template, html_template',\n  '  FROM public.email_templates',\n  '  WHERE template_key = ' + sqlLiteral(input.template_key) + ' AND template_type = 0 AND is_active = true',\n  '  LIMIT 1',\n  '), signature_template AS (',\n  '  SELECT template_key, template_name, text_template, html_template',\n  '  FROM public.email_templates',\n  '  WHERE template_key = ' + sqlLiteral(input.signature_template_key) + ' AND template_type = 2 AND is_active = true',\n  '  LIMIT 1',\n  ')',\n  'SELECT',\n  \"  COALESCE((SELECT to_jsonb(selected_case) FROM selected_case), '{}'::jsonb) AS case_row,\",\n  '  (SELECT template_key FROM message_template) AS template_key,',\n  \"  (SELECT COALESCE(NULLIF(template_name, ''), template_key) FROM message_template) AS template_name,\",\n  '  (SELECT subject_template FROM message_template) AS subject_template,',\n  '  (SELECT text_template FROM message_template) AS text_template,',\n  '  (SELECT html_template FROM message_template) AS html_template,',\n  '  (SELECT template_key FROM signature_template) AS signature_template_key,',\n  \"  (SELECT COALESCE(NULLIF(template_name, ''), template_key) FROM signature_template) AS signature_template_name,\",\n  '  (SELECT text_template FROM signature_template) AS signature_text_template,',\n  '  (SELECT html_template FROM signature_template) AS signature_html_template,',\n  '  CASE',\n  \"    WHEN NOT EXISTS (SELECT 1 FROM selected_case) THEN 'Case not found.'\",\n  \"    WHEN \" + sqlLiteral(input.template_key) + \" <> '' AND NOT EXISTS (SELECT 1 FROM message_template) THEN 'Message template was not found.'\",\n  \"    WHEN NOT EXISTS (SELECT 1 FROM signature_template) THEN 'Signature template was not found.'\",\n  '    ELSE NULL',\n  '  END AS error_message'\n].join('\\n');\nreturn [{ json: { ...input, sql } }];"
