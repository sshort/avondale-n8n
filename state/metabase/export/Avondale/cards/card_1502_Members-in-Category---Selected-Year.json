  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "template-tags": {
          "year": {
            "type": "text",
            "name": "year",
            "display-name": "Year",
            "id": "year",
            "required": true
          },
          "category": {
            "type": "text",
            "name": "category",
            "display-name": "Category",
            "id": "category",
            "required": true
          }
        },
        "lib/type": "mbql.stage/native",
        "native": "WITH current_rows AS (\n  SELECT\n    m.id AS raw_member_id,\n    trim(concat_ws(' ', m.\"First name\", m.\"Last name\")) AS member_name,\n    lower(trim(concat_ws(' ', m.\"First name\", m.\"Last name\"))) AS name_key,\n    NULLIF(lower(trim(COALESCE(m.\"Email address\", ''))), '') AS email_key,\n    NULLIF(trim(COALESCE(m.\"Venue ID\", '')), '') AS venue_id,\n    NULLIF(trim(COALESCE(m.\"British Tennis Number\", '')), '') AS btn,\n    m.\"Membership\" AS membership,\n    p.category,\n    p.display_order,\n    COALESCE(m.\"Cost\", 0) AS member_cost,\n    m.\"Payment\" AS payment,\n    m.\"Status\" AS status,\n    m.\"Email address\" AS email_address,\n    m.\"Phone number\" AS phone_number,\n    m.\"Mobile number\" AS mobile_number,\n    m.\"Postcode\" AS postcode\n  FROM public.raw_members m\n  JOIN public.membership_packages p\n    ON m.\"Membership\" = p.name\n   AND p.season = {{year}}::text\n  WHERE p.category NOT IN ('Pavilion Key', 'Honorary')\n    AND m.\"Status\" = 'Active'\n),\ncurrent_best AS (\n  SELECT DISTINCT ON (COALESCE(email_key, venue_id, btn, name_key))\n    COALESCE(email_key, venue_id, btn, name_key) AS dedupe_key,\n    raw_member_id,\n    member_name,\n    name_key,\n    email_key,\n    venue_id,\n    btn,\n    membership,\n    category,\n    display_order,\n    payment,\n    status,\n    email_address,\n    phone_number,\n    mobile_number,\n    postcode\n  FROM current_rows\n  ORDER BY COALESCE(email_key, venue_id, btn, name_key), member_cost DESC, raw_member_id DESC, display_order, membership\n)\nSELECT\n  member_name,\n  category,\n  membership AS \"Membership\",\n  payment AS \"Payment\",\n  status AS \"Status\",\n  email_address AS \"Email address\",\n  phone_number AS \"Phone number\",\n  mobile_number AS \"Mobile number\",\n  postcode AS \"Postcode\"\nFROM current_best\nWHERE category = {{category}}\nORDER BY split_part(member_name, ' ', array_length(string_to_array(member_name, ' '), 1)), member_name;"
      }
    ]
  },
